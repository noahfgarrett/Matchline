{
  "name": "@matchline/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/electron/main.js",
  "scripts": {
    "typecheck": "tsc -b && tsc -p preload/tsconfig.json && tsc -p renderer/tsconfig.json && tsc -p tsconfig.node.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:preload && npm run build:renderer",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "test": "tsc -b && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@matchline/asset-catalog": "0.1.0",
    "@matchline/compiler": "0.1.0",
    "@matchline/connectivity-import": "0.1.0",
    "@matchline/domain": "0.1.0",
    "@matchline/model-schema": "0.1.0",
    "@matchline/project-store": "0.1.0",
    "@matchline/spreadsheet-import": "0.1.0",
    "@matchline/system-resolver": "0.1.0",
    "@matchline/tag-anatomy": "0.1.0",
    "@tanstack/react-virtual": "3.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "vite": "8.2.0"
  }
}
