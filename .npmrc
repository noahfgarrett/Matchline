# Supply chain security hardening (CLAUDE.md, "npm Supply Chain Security").
#
# Blocks postinstall scripts by default — the mechanism a compromised package
# uses to run code the moment it is installed. This was previously only set in
# the developer's own ~/.npmrc, which does not exist on a CI runner: `npm ci`
# in GitHub Actions ran every package's install scripts unguarded.
#
# A package that legitimately needs one (e.g. electron, esbuild) is rebuilt
# explicitly: `npm rebuild <pkg>`. `postsetup` in the root package.json already
# does this for electron and esbuild.
ignore-scripts=true
