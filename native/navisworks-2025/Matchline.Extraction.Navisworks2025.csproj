<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Navisworks 2025 version adapter: the year the Phase 1 Windows proof run
    targets (docs/WINDOWS-RUNBOOK.md).

    Everything about it except the year comes from
    native/navisworks-adapter/Matchline.Navisworks.Adapter.props, which also
    holds the one copy of the Autodesk touching source. The year drives the
    assembly name (Matchline.Extraction.Navisworks2025), the default install
    path (C:\Program Files\Autodesk\Navisworks Manage 2025) and, through
    AdapterIdentity.cs, meta.adapter_version = "navisworks-2025".

    Support status: compiles, proof run still pending. SupportedAdapters in
    native/navisworks-common is the source of truth and the launcher says so out
    loud; see docs/EXTRACTION.md.
  -->
  <PropertyGroup>
    <MatchlineNavisworksYear>2025</MatchlineNavisworksYear>
  </PropertyGroup>

  <Import Project="..\navisworks-adapter\Matchline.Navisworks.Adapter.props" />

</Project>
